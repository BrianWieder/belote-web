# HTTP / Socket.io server listen port
PORT=3001

# Allowed CORS origin(s) for the web client (supports comma-separated list)
CLIENT_URL=http://localhost:5173

# Optional Metered REST API TURN configuration (served via GET /ice-servers)
# Set either METERED_DOMAIN (e.g. myapp.metered.live) or METERED_APP_NAME (e.g. myapp)
METERED_DOMAIN=
METERED_APP_NAME=
METERED_API_KEY=

# Optional static Metered TURN fallback (used if Metered API vars are not set)
TURN_USERNAME=
TURN_CREDENTIAL=
