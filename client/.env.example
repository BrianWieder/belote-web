# Signaling server URL (defaults to http://localhost:3001 in dev)
VITE_SERVER_URL=http://localhost:3001

# Optional TURN relay credentials (Metered) for WebRTC fallback on strict NATs
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Optional Sentry DSN for runtime error and performance monitoring
VITE_SENTRY_DSN=

# Optional build-time Sentry source map upload (CI / production builds only)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
